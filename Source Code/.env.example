# Copy this file to .env and add the key only when real Gemini testing begins.
GEMINI_API_KEY=replace_with_your_key
# Optional: used only after the primary key receives a Gemini 429/rate-limit response.
GEMINI_BACKUP_API_KEY=replace_with_your_spare_key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_DAILY_REQUEST_LIMIT=30
APP_PROVIDER=gemini
